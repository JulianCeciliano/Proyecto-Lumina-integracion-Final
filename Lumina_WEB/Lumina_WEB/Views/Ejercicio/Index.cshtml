@*
 * ════════════════════════════════════════════════════
 *  VISTA: Index.cshtml
 *
 *  Muestra el listado de ejercicios como una cuadrícula
 *  de tarjetas (una tarjeta por ejercicio) con un pequeño
 *  resumen decorativo para el panel de admin.
 *
 *  Estilos: todos los selectores usan el prefijo "ej-"
 *  para no interferir con el layout compartido. Las
 *  variables de color provienen del layout (_Layout.cshtml).
 * ════════════════════════════════════════════════════
 *@

@model IEnumerable<Lumina_WEB.Models.Ejercicio>

@{
    ViewData["Title"] = "Ejercicios";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // ── Datos del resumen (decorativo) ──
    var total = Model != null ? Model.Count() : 0;
    var emojis = new[] { "🏋️", "🧘", "🤸", "🧗", "🏃", "🚴" };
}

<style>
    .ej-wrap { width: 100%; padding: 32px 24px 60px; }

    /* ── CABECERA DE PÁGINA ── */
    .ej-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
    .ej-eyebrow { font-size: 10px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: var(--c4); }
    .ej-title { font-family: 'Cormorant Garamond', serif; font-size: 34px; font-weight: 600; color: var(--text); line-height: 1.1; margin-top: 2px; }
    .ej-sub { font-size: 12px; color: var(--soft); margin-top: 4px; }

    /* ── BOTONES ── */
    .ej-btn { display: inline-flex; align-items: center; gap: 7px; padding: 10px 18px; border-radius: 10px; font-size: 12px; font-weight: 700; cursor: pointer; text-decoration: none; transition: transform .12s, box-shadow .12s; }
    .ej-btn-p { background: linear-gradient(135deg, var(--c4), var(--c5)); color: #fff; border: none; box-shadow: 0 6px 16px rgba(242, 119, 110, .35); }
    .ej-btn-p:hover { text-decoration: none; color: #fff; transform: translateY(-1px); box-shadow: 0 8px 20px rgba(242, 119, 110, .4); }
    .ej-btn-s { background: var(--white); border: 1.5px solid var(--border); color: var(--muted); }
    .ej-btn-s:hover { text-decoration: none; color: var(--c5); border-color: var(--c4); background: var(--c1); }

    /* ── TARJETA DE RESUMEN ── */
    .ej-stats { display: flex; margin-bottom: 24px; }
    .ej-stat { display: flex; align-items: center; gap: 14px; background: linear-gradient(135deg, var(--c5), var(--c4)); border: none; border-radius: 14px; padding: 16px 20px; min-width: 240px; }
    .ej-stat .ico { width: 42px; height: 42px; border-radius: 12px; background: rgba(255, 255, 255, .22); display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
    .ej-stat .val { font-size: 22px; font-weight: 800; color: #fff; line-height: 1.1; }
    .ej-stat .lbl { font-size: 10px; font-weight: 700; color: rgba(255, 255, 255, .8); text-transform: uppercase; letter-spacing: .06em; margin-top: 2px; }

    /* ── CUADRÍCULA DE TARJETAS ── */
    .ej-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    media (max-width: 1300px) { .ej-grid { grid-template-columns: repeat(3, 1fr); } }
    media (max-width: 1000px) { .ej-grid { grid-template-columns: repeat(2, 1fr); } }
    media (max-width: 600px) { .ej-grid { grid-template-columns: 1fr; } }
    .ej-card { background: var(--white); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; transition: transform .15s, box-shadow .15s; }
    .ej-card:hover { transform: translateY(-3px); box-shadow: 0 12px 26px rgba(61, 31, 26, .08); }
    .ej-card .top { height: 6px; background: linear-gradient(90deg, var(--c4), var(--border)); }
    .ej-card-body { padding: 18px 18px 14px; flex: 1; display: flex; flex-direction: column; gap: 10px; }
    .ej-row { display: flex; align-items: center; gap: 10px; }
    .ej-ico { width: 38px; height: 38px; border-radius: 10px; background: var(--c1); display: flex; align-items: center; justify-content: center; font-size: 19px; }
    .ej-num { margin-left: auto; font-size: 10px; font-weight: 800; color: var(--soft); letter-spacing: .08em; }
    .ej-name { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 600; color: var(--text); line-height: 1.2; }
    .ej-desc { font-size: 12px; color: var(--muted); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; min-height: 60px; }
    .ej-foot { display: flex; gap: 8px; padding: 12px 18px 16px; border-top: 1px solid var(--c1); }
    .ej-mini { flex: 1; text-align: center; padding: 8px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; text-decoration: none; border: 1.5px solid var(--border); background: var(--white); color: var(--muted); transition: background .12s, color .12s, border-color .12s; }
    .ej-mini:hover { text-decoration: none; background: var(--c1); color: var(--c5); border-color: var(--c4); }
    .ej-mini.danger { color: #B91C1C; border-color: #FECACA; }
    .ej-mini.danger:hover { background: #FEF2F2; color: #B91C1C; border-color: #FCA5A5; }

    /* ── ESTADO VACÍO ── */
    .ej-empty { background: var(--white); border: 1.5px dashed var(--border); border-radius: 14px; padding: 56px 24px; text-align: center; }
    .ej-empty .ico { font-size: 44px; margin-bottom: 10px; }
    .ej-empty h3 { font-family: 'Cormorant Garamond', serif; font-size: 22px; color: var(--text); font-weight: 600; margin-bottom: 6px; }
    .ej-empty p { font-size: 12px; color: var(--soft); margin-bottom: 18px; }
</style>

<div class="ej-wrap">

    <div class="ej-head">
        <div>
            <div class="ej-eyebrow">Panel admin</div>
            <h1 class="ej-title">Ejercicios</h1>
            <div class="ej-sub">@total ejercicio(s) registrado(s) para los usuarios de Lúmina</div>
        </div>
        <a asp-action="Crear" class="ej-btn ej-btn-p">➕ Nuevo ejercicio</a>
    </div>

    <div class="ej-stats">
        <div class="ej-stat">
            <div class="ico">🏋️</div>
            <div>
                <div class="val">@total</div>
                <div class="lbl">Ejercicios registrados</div>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="ej-grid">
            @{ var i = 0; }
            @foreach (var item in Model)
            {
                var emoji = emojis[i % emojis.Length];
                var numero = (i + 1).ToString("00");
                <div class="ej-card">
                    <div class="top"></div>
                    <div class="ej-card-body">
                        <div class="ej-row">
                            <div class="ej-ico">@emoji</div>
                            <div class="ej-num">#@numero</div>
                        </div>
                        <div class="ej-name">@(item.Nombre ?? "Sin nombre")</div>
                        <div class="ej-desc">@(item.Descripcion ?? "")</div>
                    </div>
                    <div class="ej-foot">
                        <a asp-action="Editar" asp-route-id="@item.Id" class="ej-mini">✏️ Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@item.Id" class="ej-mini danger">🗑️ Eliminar</a>
                    </div>
                </div>
                i++;
            }
        </div>
    }
    else
    {
        <div class="ej-empty">
            <div class="ico">🏋️</div>
            <h3>Todavía no hay ejercicios</h3>
            <p>Crea el primer ejercicio para que los usuarios tengan algo con qué practicar.</p>
            <a asp-action="Crear" class="ej-btn ej-btn-p">➕ Crear el primero</a>
        </div>
    }

</div>
