@model IEnumerable<Lumina_WEB.Models.Ejercicio>
@{
    ViewData["Title"] = "Ejercicios";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var total = Model != null ? Model.Count() : 0;
    var emojis = new[] { "🏋️", "🧘", "🤸", "🧗", "🏃", "🚴" };
}

<style>
    .eu-wrap { width: 100%; padding: 32px 24px 60px; }

    .eu-eyebrow { font-size: 10px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: var(--c4); margin-bottom: 4px; }
    .eu-title { font-family: 'Cormorant Garamond', serif; font-size: 34px; font-weight: 600; color: var(--text); line-height: 1.1; }
    .eu-sub { font-size: 12px; color: var(--soft); margin-top: 4px; margin-bottom: 28px; }

    .eu-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    @@media (max-width: 1300px) { .eu-grid { grid-template-columns: repeat(3, 1fr); } }
    @@media (max-width: 1000px) { .eu-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 600px) { .eu-grid { grid-template-columns: 1fr; } }

    .eu-card { background: var(--white); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; transition: transform .15s, box-shadow .15s; }
    .eu-card:hover { transform: translateY(-3px); box-shadow: 0 12px 26px rgba(61, 31, 26, .08); }
    .eu-card .top { height: 6px; background: linear-gradient(90deg, var(--c4), var(--border)); }
    .eu-card-body { padding: 18px 18px 16px; flex: 1; display: flex; flex-direction: column; gap: 10px; }
    .eu-row { display: flex; align-items: center; gap: 10px; }
    .eu-ico { width: 38px; height: 38px; border-radius: 10px; background: var(--c1); display: flex; align-items: center; justify-content: center; font-size: 19px; }
    .eu-num { margin-left: auto; font-size: 10px; font-weight: 800; color: var(--soft); letter-spacing: .08em; }
    .eu-name { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 600; color: var(--text); line-height: 1.2; }
    .eu-desc { font-size: 12px; color: var(--muted); line-height: 1.55; }

    .eu-empty { background: var(--white); border: 1.5px dashed var(--border); border-radius: 14px; padding: 56px 24px; text-align: center; }
    .eu-empty .ico { font-size: 44px; margin-bottom: 10px; }
    .eu-empty h3 { font-family: 'Cormorant Garamond', serif; font-size: 22px; color: var(--text); font-weight: 600; margin-bottom: 6px; }
    .eu-empty p { font-size: 12px; color: var(--soft); margin-bottom: 18px; }
</style>

<div class="eu-wrap">

    <div class="eu-eyebrow">Para ti</div>
    <h1 class="eu-title">Ejercicios</h1>
    <div class="eu-sub">Practica cuando lo necesites</div>

    @if (Model != null && Model.Any())
    {
        <div class="eu-grid">
            @{ var i = 0; }
            @foreach (var item in Model)
            {
                var emoji = emojis[i % emojis.Length];
                var numero = (i + 1).ToString("00");
                <div class="eu-card">
                    <div class="top"></div>
                    <div class="eu-card-body">
                        <div class="eu-row">
                            <div class="eu-ico">@emoji</div>
                            <div class="eu-num">#@numero</div>
                        </div>
                        <div class="eu-name">@(item.Nombre ?? "Sin nombre")</div>
                        <div class="eu-desc">@(item.Descripcion ?? "")</div>
                    </div>
                </div>
                i++;
            }
        </div>
    }
    else
    {
        <div class="eu-empty">
            <div class="ico">🏋️</div>
            <h3>No hay ejercicios aún</h3>
            <p>Pronto habrá ejercicios disponibles para ti.</p>
        </div>
    }

</div>
